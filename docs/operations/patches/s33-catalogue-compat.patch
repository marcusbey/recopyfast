+/**
+ * A catalogue migration may add rows before every application instance has
+ * restarted. Ignore ids this loader generation cannot sell while continuing
+ * to parse every known row strictly, so malformed existing prices still fail.
+ */
+const KNOWN_CATALOGUE_IDS = new Set([
+  "free",
+  "starter",
+  "pro",
+  "credits",
+  "lifetime_pro",
+]);
+const warnedUnknownCatalogueRows = new Set<string>();
+
+function isKnownCatalogueRow(row: PlanRow): boolean {
+  if (KNOWN_CATALOGUE_IDS.has(row.id)) return true;
+  if (!warnedUnknownCatalogueRows.has(row.id)) {
+    warnedUnknownCatalogueRows.add(row.id);
+    console.warn(`Ignoring unknown active plans row "${row.id}" (${row.kind}).`);
+  }
+  return false;
+}
+
