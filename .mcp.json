{
  "inputs": [
    {
      "type": "promptString",
      "id": "stripe-secret-key",
      "description": "Stripe Secret Key (sk_test_... or sk_live_...)",
      "password": true
    },
    {
      "type": "promptString",
      "id": "github-token",
      "description": "GitHub Personal Access Token",
      "password": true
    }
  ],
  "mcpServers": {
    "stripe": {
      "command": "npx",
      "args": [
        "-y",
        "@stripe/mcp",
        "--tools=customers.create,customers.read,customers.update,payments.create,payments.read,subscriptions.create,subscriptions.read,subscriptions.update,products.create,products.read,prices.create,prices.read,refunds.create"
      ],
      "env": {
        "STRIPE_SECRET_KEY": "${input:stripe-secret-key}"
      }
    },
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-token}"
      }
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=uexwowziiigweobgpmtk&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}