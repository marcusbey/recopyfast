# =============================================================================
# RecopyFast — Environment Variables
# Copy this file to .env.local for local development.
# Never commit real secrets to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (required)
# Find these in your Supabase project → Settings → API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Direct Postgres connection — only used by the one-off bootstrap script
# `node setup-db-direct.js`. The app itself never reads these; migrations run
# through the Supabase CLI. Set DATABASE_URL, or the discrete pair below.
# Find the password in Supabase → Settings → Database.
# DATABASE_URL=postgresql://postgres:<password>@db.your-project-ref.supabase.co:5432/postgres
# SUPABASE_DB_HOST=db.your-project-ref.supabase.co
# SUPABASE_PASSWORD=your-database-password

# -----------------------------------------------------------------------------
# Stripe — test keys (required for billing features)
# Use live keys only in production; keep test keys for staging/local.
# Find these in Stripe Dashboard → Developers → API keys
#
# The _LIVE suffix, not the value, decides which pair is read: src/lib/stripe/
# mode.ts selects live only when VERCEL_ENV=production. Putting a live secret in
# an unsuffixed variable does not make anything live — it makes preview and
# local fail against the test-mode Stripe account.
#
# STRIPE_WEBHOOK_SECRET is PER-ENVIRONMENT: every Stripe webhook *endpoint* has
# its own signing secret, so `stripe listen` locally, the endpoint pointed at a
# preview, and the live endpoint are three different values. A wrong one is not
# a warning — every webhook 400s and nothing provisions. Locally, copy the
# whsec_… that this prints:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Live keys (production only — do NOT set these in .env.local)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_...
# STRIPE_SECRET_KEY_LIVE=sk_live_...
# STRIPE_WEBHOOK_SECRET_LIVE=whsec_...

# -----------------------------------------------------------------------------
# Stripe Price IDs — Starter plan
# -----------------------------------------------------------------------------
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_STARTER_YEARLY_PRICE_ID=price_...

# Stripe Price IDs — Starter plan (live, production only)
# STRIPE_STARTER_PRICE_ID_LIVE=price_...
# STRIPE_STARTER_YEARLY_PRICE_ID_LIVE=price_...

# -----------------------------------------------------------------------------
# Stripe Price IDs — Pro plan
# -----------------------------------------------------------------------------
STRIPE_PRO_PRICE_ID=price_...
STRIPE_PRO_YEARLY_PRICE_ID=price_...

# Stripe Price IDs — Pro plan (live, production only)
# STRIPE_PRO_PRICE_ID_LIVE=price_...
# STRIPE_PRO_YEARLY_PRICE_ID_LIVE=price_...

# -----------------------------------------------------------------------------
# Stripe Price IDs — Enterprise plan
# -----------------------------------------------------------------------------
STRIPE_ENTERPRISE_PRICE_ID=price_...
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_...

# Stripe Price IDs — Enterprise plan (live, production only)
# STRIPE_ENTERPRISE_PRICE_ID_LIVE=price_...
# STRIPE_ENTERPRISE_YEARLY_PRICE_ID_LIVE=price_...

# -----------------------------------------------------------------------------
# Stripe Price IDs — one-time products
# -----------------------------------------------------------------------------
# Both are REQUIRED: checkout throws rather than guess a price, so an unset
# variable here is a product that cannot be bought at all. That is exactly how
# Lifetime Pro came to be advertised at $199 with no way to pay for it.
#
# STRIPE_TICKETS_PRICE_ID keeps its old name even though the product is now
# called Credits — the variable is configured outside this repo, in Vercel and
# in every developer's .env, so renaming it here would break checkout in every
# environment the moment it deployed. See src/lib/stripe/plans.ts.
STRIPE_TICKETS_PRICE_ID=price_...
STRIPE_LIFETIME_PRICE_ID=price_...

# Stripe Price IDs — one-time products (live, production only)
# STRIPE_TICKETS_PRICE_ID_LIVE=price_...
# STRIPE_LIFETIME_PRICE_ID_LIVE=price_...
#
# `npm run check:stripe` (and `check:stripe:live`) verifies every one of these
# resolves in the right mode, charges the amount the `plans` table says, and
# describes the product the way the app does.

# -----------------------------------------------------------------------------
# Redis (required in production for rate limiting)
#
# REDIS_URL must be set in production — the app fails at first use without it,
# deliberately, to prevent silent rate-limit bypass on Vercel.
#
# Provider: Upstash (console.upstash.com). Serverless connection model, so it
# suits Vercel functions better than a always-on instance. Copy the connection
# string from the database page; it is already rediss://.
#
#   Format:  rediss://default:<password>@<host>.upstash.io:6379
#   Local:   redis://localhost:6379  (dev never uses Redis — see below)
#
# Dev does NOT touch Redis. The limiter picks its store from NODE_ENV
# (src/lib/security/rate-limiter.ts), so `npm run dev` runs on the in-memory
# limiter and works with this variable unset or pointing at nothing.
#
# WARNING — a metered free tier is a production dependency, not a freebie.
# Each rate-limit check costs 2 Redis commands. Ten of the API endpoints fail
# CLOSED when the store errors, so BLOWING THE COMMAND QUOTA TAKES DOWN EDITOR
# LOGIN exactly the way a deleted instance does. Watch the usage graph, and set
# a billing alert before the cap rather than after.
#
# Verify any URL before trusting it:  npm run check:redis
# -----------------------------------------------------------------------------
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# -----------------------------------------------------------------------------
# CORS — allowed origins for API cross-origin requests
# Comma-separated list of exact origins (scheme + host + optional port).
# Wildcard "*" is intentionally NOT supported.
# Example: https://app.example.com,https://www.example.com
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Application URL (used for generating absolute links, webhooks, etc.)
#
# PER-ENVIRONMENT. This is the one variable that must NOT be shared across
# Vercel environments. NEXT_PUBLIC_* is inlined at build time, so a preview
# deployment bakes in whatever value the project had — and a project that ticks
# this for all three environments ships the production origin inside every
# preview. Confirming a magic link on a preview then set the session cookie on
# the preview host and redirected to production, where that cookie does not
# exist, so the user arrived logged out. Stripe returns bounced the same way.
#
#   local       http://localhost:3000   (here, or in .env.local)
#   preview     leave UNSET — the auth redirect falls back to Vercel's own
#               per-deployment hostname, and so do the Checkout return URLs
#   production  https://www.recopyfa.st
#
# See docs/DEPLOYMENT-ENV.md.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WebSocket server URL (used by the client to connect to the Socket.io server)
# In development the Socket.io server runs separately from the Next.js dev server.
#
# CHANGING THIS REQUIRES A REBUILD, NOT A RESTART. It is read in three places and
# one of them is a "use client" component (SiteDetailView), so the value is
# inlined into the bundle at build time — while the two API snippet producers and
# the CSP connect-src in middleware.ts read it at runtime. Set it without
# redeploying and the dashboard shows a snippet WITHOUT data-ws-url while the API
# returns one WITH it: a disagreement nobody thinks to look for, because each
# snippet looks correct on its own. Set, then redeploy, then compare the two.
#
# Production (deployed 2026-08-17): wss://recopyfast-ws.fly.dev, and set in the
# PRODUCTION environment only — a preview pointed at it shares site:{id} rooms
# with live customers. Unsetting it and redeploying is the kill switch: realtime
# turns off cleanly and HTTP keeps serving. See server/README.md.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_WS_URL=http://localhost:4001

# WebSocket server port (server/index.js)
WS_PORT=4001

# -----------------------------------------------------------------------------
# OpenAI (required for AI-powered features)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Admin access control
# Comma-separated list of email addresses granted admin privileges server-side.
# These are compared (case-insensitively) against the authenticated user's email
# in API routes that require admin access (blog generation, audit logs, compliance
# reports). This is the PRIMARY server-managed allowlist; role can also be granted
# via the Supabase Admin SDK by setting app_metadata.role="admin".
# NEVER grant admin based on user_metadata — that field is caller-writable.
# Example: admin@example.com,ops@example.com
# -----------------------------------------------------------------------------
ADMIN_EMAILS=

# -----------------------------------------------------------------------------
# Cron job secret (required to authenticate scheduled cron requests)
# Generate a random 32+ character string and set it here and in your
# Vercel / cron provider configuration.
# -----------------------------------------------------------------------------
CRON_SECRET=your-cron-secret-min-32-chars

# -----------------------------------------------------------------------------
# Sentry (optional — error monitoring)
# Set NEXT_PUBLIC_SENTRY_DSN to enable Sentry in the browser bundle.
# next.config.ts only wraps the build with withSentryConfig when the DSN is set.
#
# SENTRY_ORG / SENTRY_PROJECT are read by the Sentry webpack plugin to upload
# source maps at build time. Without them, production stack traces stay minified.
# SENTRY_AUTH_TOKEN must also be set in the CI/Vercel environment (never here)
# for the upload to authenticate.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug

# -----------------------------------------------------------------------------
# Email — Resend (transactional: staging verification codes)
# Create an API key at https://resend.com/api-keys and verify your sending domain.
# EMAIL_FROM must use a verified domain/address.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_your_api_key
# recopyfa.st is the verified sending domain. recopyfast.com is NOT on the
# Resend account — using it makes every send fail with "domain is not verified",
# which reads as "invite created" in the UI and as nothing at all in the inbox.
EMAIL_FROM=ReCopyFast <noreply@recopyfa.st>

# -----------------------------------------------------------------------------
# Logging — IP pseudonymization salt (GDPR)
# Stable random secret used to hash client IPs before they enter logs.
# Set a long random value; if unset, a per-process random salt is used
# (still non-reversible, but not stable across restarts).
# -----------------------------------------------------------------------------
LOG_IP_SALT=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Vercel (set automatically by Vercel — do not set manually)
# Listed here for documentation purposes only.
#
# VERCEL_ENV is the live/test discriminator for Stripe (src/lib/stripe/mode.ts)
# and the signal that lets auth redirects prefer this deployment's own hostname
# over an inherited NEXT_PUBLIC_APP_URL (src/app/auth/public-origin.ts). Both
# read it at runtime, so neither is affected by build-time inlining. Vercel
# supplies the URL variables as bare hostnames, without a scheme.
# -----------------------------------------------------------------------------
# VERCEL_ENV=production|preview|development
# VERCEL_URL=recopyfast-abc123.vercel.app
# VERCEL_BRANCH_URL=recopyfast-git-my-branch.vercel.app
# VERCEL_PROJECT_PRODUCTION_URL=recopyfa.st
# VERCEL_REGION=iad1
